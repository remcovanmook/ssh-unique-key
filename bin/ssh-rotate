#!/bin/bash
# Stub. The original ssh-rotate called helper functions that were never
# defined anywhere and was unrunnable as shipped (ARCHITECTURE.md W9 lists
# them). Rather than ship broken code, it is disabled until it is rebuilt
# from scratch in REFACTOR.md Phase 5.
#
# To rotate a single user's key on a host, use ssh-user-rotate.
set -e
echo "ssh-rotate is not available: the shipped implementation was broken and" >&2
echo "has been removed. It will be rebuilt in refactor Phase 5 (see REFACTOR.md)." >&2
echo "To rotate one user's key on a host, use: ssh-user-rotate <uuid> <user>" >&2
exit 1
